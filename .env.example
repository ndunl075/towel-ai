# Optional. Without a key the app falls back to the local heuristic extractor,
# so the demo still works offline.
ANTHROPIC_API_KEY=

# Optional override. Defaults to claude-opus-5.
NAPKIN_MODEL=claude-opus-5

# Extraction requests allowed per client address per window. 0 disables the
# limiter. Only meaningful if you expose this to anyone but yourself - see the
# deploying section of the README.
NAPKIN_RATE_LIMIT=20
NAPKIN_RATE_WINDOW=60
