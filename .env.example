# Optional. With no key the app tries a local Ollama server, then falls back to
# the built-in heuristic extractor, so the demo works offline either way.
ANTHROPIC_API_KEY=

# Optional override. Defaults to claude-opus-5.
NAPKIN_MODEL=claude-opus-5

# Extraction requests allowed per client address per window. 0 disables the
# limiter. Only meaningful if you expose this to anyone but yourself - see the
# deploying section of the README.
NAPKIN_RATE_LIMIT=20
NAPKIN_RATE_WINDOW=60

# auto (default) prefers Anthropic when a key is set and otherwise looks for a
# local Ollama server. Name one explicitly when both are available.
NAPKIN_PROVIDER=auto
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# Reasoning models think for minutes before answering, far too slow for an
# interactive path. Set to 1 only if you want that.
# NAPKIN_OLLAMA_THINK=1
